# 开发环境配置
ENV = 'development'

# 管理系统/开发环境，api请求的基础路径
VUE_APP_BASE_API = '/dev-api'

# 本地联调：指向本机 Blog-API（你当前为 https://127.0.0.1:8443 / prod 配置）。
# 若跑 application-dev.yml（9002）则改为 http://127.0.0.1:9002。改完必须重启 npm run serve。
VUE_APP_PROXY_TARGET=https://api.example.com:8443

# WebSocket：留空则走「当前域名 + VUE_APP_BASE_API + /websocket」
# VUE_APP_WS_URL=
BASE_URL = '/'

# 仅开发可开（利于 HMR）：会把 import() 转成 require。生产 .env.production 绝不能带此变量。
VUE_CLI_BABEL_TRANSPILE_MODULES = true
