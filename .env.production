# 生产环境配置
ENV=production

# 管理系统/生产环境，api请求的基础路径
VUE_APP_BASE_API=/pro-api

# WebSocket：默认走同源 wss://当前域名/pro-api/websocket（安卓更稳）
# 因为当前域名代理的是 /pro-api 的 Upgrade，所以需要使用 /pro-api/websocket
# 同源失败时自动尝试下面的直连备用地址（需 Nginx 已反代 /pro-api 的 Upgrade）
# 示例：wss://api.example.com/websocket，替换为你的后端原始WebSocket地址
VUE_APP_WS_URL=
VUE_APP_WS_URL_FALLBACK=wss://api.example.com/websocket

BASE_URL=/

# 注意：不要设置 VUE_CLI_BABEL_TRANSPILE_MODULES
# 该变量只要存在（即使是 false 字符串）也会在 JS 里被当成 true，
# 从而启用 dynamic-import-node，毁掉生产环境 import() 分包。
